# ANTHROPIC_API_KEY は不要 — GM は Meridian が Claude Code の認証情報を使用する
#
# claude login を実行済みの ~/.claude ディレクトリへのパスを指定する
#
# Windows
CLAUDE_DIR=C:/Users/your-username/.claude
# macOS / Linux
# CLAUDE_DIR=/Users/your-username/.claude

# Solver (Ollama) 設定
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.6:27b
OLLAMA_TIMEOUT=27000

# Meridian (Claude) モデル設定 — GM・Solver 共通
MERIDIAN_MODEL=claude-sonnet-4-6

# Solver (OpenRouter) 設定 — --solver-backend openrouter 使用時に必要
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=qwen/qwen3.6-plus-preview:free
OPENROUTER_TIMEOUT=120
